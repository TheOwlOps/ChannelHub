{
  "name": "@theowlops/channelhub",
  "version": "2.1.0",
  "description": "ChannelHub SDK v2 - Unified multi-channel messaging toolkit (Zalo, Telegram, Discord, Slack, TikTok, Twilio) for AI agents, standalone bots, and enterprise automation.",
  "module": "dist/index.js",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "channelhub": "dist/apps/cli.js",
    "channelhub-mcp": "dist/apps/mcp-server.js",
    "zalohub": "dist/apps/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs",
      "types": "./dist/core/index.d.ts"
    },
    "./channels/zalo": {
      "import": "./dist/channels/zalo/index.js",
      "require": "./dist/channels/zalo/index.cjs",
      "types": "./dist/channels/zalo/index.d.ts"
    },
    "./channels/telegram": {
      "import": "./dist/channels/telegram/index.js",
      "require": "./dist/channels/telegram/index.cjs",
      "types": "./dist/channels/telegram/index.d.ts"
    },
    "./channels/discord": {
      "import": "./dist/channels/discord/index.js",
      "require": "./dist/channels/discord/index.cjs",
      "types": "./dist/channels/discord/index.d.ts"
    },
    "./channels/slack": {
      "import": "./dist/channels/slack/index.js",
      "require": "./dist/channels/slack/index.cjs",
      "types": "./dist/channels/slack/index.d.ts"
    },
    "./channels/messenger": {
      "import": "./dist/channels/messenger/index.js",
      "require": "./dist/channels/messenger/index.cjs",
      "types": "./dist/channels/messenger/index.d.ts"
    },
    "./channels/messenger-personal": {
      "import": "./dist/channels/messenger-personal/index.js",
      "require": "./dist/channels/messenger-personal/index.cjs",
      "types": "./dist/channels/messenger-personal/index.d.ts"
    },
    "./channels/tiktok": {
      "import": "./dist/channels/tiktok/index.js",
      "require": "./dist/channels/tiktok/index.cjs",
      "types": "./dist/channels/tiktok/index.d.ts"
    },
    "./channels/twilio": {
      "import": "./dist/channels/twilio/index.js",
      "require": "./dist/channels/twilio/index.cjs",
      "types": "./dist/channels/twilio/index.d.ts"
    },
    "./channels/email": {
      "import": "./dist/channels/email/index.js",
      "require": "./dist/channels/email/index.cjs",
      "types": "./dist/channels/email/index.d.ts"
    },
    "./channels/github": {
      "import": "./dist/channels/github/index.js",
      "require": "./dist/channels/github/index.cjs",
      "types": "./dist/channels/github/index.d.ts"
    },
    "./channels/calendar": {
      "import": "./dist/channels/calendar/index.js",
      "require": "./dist/channels/calendar/index.cjs",
      "types": "./dist/channels/calendar/index.d.ts"
    },
    "./channels/webhook-generic": {
      "import": "./dist/channels/webhook-generic/index.js",
      "require": "./dist/channels/webhook-generic/index.cjs",
      "types": "./dist/channels/webhook-generic/index.d.ts"
    },
    "./bridges/mcp": {
      "import": "./dist/bridges/mcp/index.js",
      "require": "./dist/bridges/mcp/index.cjs",
      "types": "./dist/bridges/mcp/index.d.ts"
    },
    "./bridges/webhook": {
      "import": "./dist/bridges/webhook/index.js",
      "require": "./dist/bridges/webhook/index.cjs",
      "types": "./dist/bridges/webhook/index.d.ts"
    },
    "./bridges/dashboard": {
      "import": "./dist/bridges/dashboard/index.js",
      "require": "./dist/bridges/dashboard/index.cjs",
      "types": "./dist/bridges/dashboard/index.d.ts"
    },
    "./legacy/zalo": {
      "import": "./dist/legacy/zalo/index.js",
      "require": "./dist/legacy/zalo/index.cjs",
      "types": "./dist/legacy/zalo/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "README.vi.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "login:personal": "bun run scripts/login_personal.ts",
    "login:messenger": "bun run scripts/login_messenger.ts",
    "mcp": "node dist/apps/mcp-server.js",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run scripts/build.ts",
    "build:check": "bun x tsc --noEmit",
    "test": "bun test tests/",
    "bench": "bun run scripts/benchmark.ts",
    "stats": "bun run scripts/generate-badge.ts",
    "test:smoke": "bun test test/clean-install.test.ts",
    "prepublishOnly": "bun run build && bun test",
    "release": "npm version patch && git push origin main --tags",
    "cli": "bun run apps/cli/main.ts"
  },
  "keywords": [
    "channelhub",
    "messaging",
    "multi-channel",
    "zalo",
    "telegram",
    "discord",
    "slack",
    "mcp",
    "ai-agent",
    "hermes",
    "openclaw",
    "chatbot",
    "webhook",
    "dashboard",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOwlOps/ChannelHub.git"
  },
  "bugs": {
    "url": "https://github.com/TheOwlOps/ChannelHub/issues"
  },
  "homepage": "https://github.com/TheOwlOps/ChannelHub#readme",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "playwright": "^1.63.0",
    "sharp": "^0.33.0 || ^0.34.0 || ^0.35.0",
    "zca-js": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "zca-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.0.0",
    "bun-types": "latest",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "zca-js": "^2.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
